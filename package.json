{
  "name": "android-mobile-autotests",
  "version": "1.0.0",
  "private": true,
  "description": "Android mobile test automation: Appium + WebdriverIO (JavaScript) and Maestro, Page Object, Allure, GitHub Actions on Android emulator",
  "scripts": {
    "test": "wdio run ./appium/wdio.conf.js",
    "test:smoke": "wdio run ./appium/wdio.conf.js --mochaOpts.grep @smoke",
    "allure": "allure generate allure-results --clean -o allure-report"
  },
  "author": "Sony Fridmo",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0"
  }
}
